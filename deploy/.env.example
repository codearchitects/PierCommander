# Copy to deploy/.env and adjust. Never commit the filled-in file.

# Where the published images live (set by the release workflow).
REGISTRY=ghcr.io
IMAGE_NAMESPACE=codearchitects/piercommander
IMAGE_TAG=latest

# The host directory PierCommander manages. Everything outside it is
# unreachable by design -- pick it deliberately.
FS_HOST_ROOT=./data

# Port the UI is published on.
WEB_PORT=8080
